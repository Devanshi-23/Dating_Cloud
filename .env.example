# Copy to config/<name>.env (git-ignored) and pass with:
#   flutter run --dart-define-from-file=config/<name>.env
# Placeholders only. Never put private API keys or provider secrets here;
# everything in this file is compiled into the app binary.

# development | staging | production
APP_ENV=development

# mock | api | hybrid
DATA_MODE=mock

# Required when DATA_MODE is api or hybrid. Must be https in production.
API_BASE_URL=https://api.example.invalid/api/v1
SOCKET_BASE_URL=https://api.example.invalid

# hybrid only: comma-separated features that stay on mock data.
# auth, profile, discovery, swipes, matches, chat, subscriptions
HYBRID_MOCK_FEATURES=

# Simulated mock latency in milliseconds.
MOCK_LATENCY_MS=600

# Internal builds only. Lets a production build run mock data.
ALLOW_INTERNAL_MOCK=false

# Optional modules.
FEATURE_CALLS=false
FEATURE_AI_ASSISTANT=false
