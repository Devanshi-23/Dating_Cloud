# Copy to backend/.env. Local development only. Do not put real provider secrets here.

PORT=3000

# Sign these yourself for anything beyond this machine.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Fixed code accepted by POST /auth/otp/verify. No SMS is sent.
DEV_OTP_CODE=123456
OTP_EXPIRES_SECONDS=300
OTP_RESEND_SECONDS=30

# This number opens the seeded, already-onboarded account (Alex).
# Any other valid E.164 number creates a new account that must onboard.
DEMO_PHONE=+919876543210

TERMS_VERSION=2026-01

# Phone:ROLE for the admin API. ROLE is MODERATOR or ADMIN. Comma-separated.
# Sign in with that number and DEV_OTP_CODE. Members get 403 on /admin/*.
STAFF_ROLES=+919111111111:ADMIN
